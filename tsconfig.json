{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["node", "aws-lambda"]
  },
  "include": ["app/**/*.ts", "scripts/**/*.ts"]
}
