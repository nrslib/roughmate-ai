{
  "display_information": {
    "name": "Roughmate",
    "description": "AIの返信下書きを作る相棒",
    "background_color": "#23344a"
  },
  "features": {
    "bot_user": {
      "display_name": "Roughmate",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "channels:join",
        "groups:history",
        "groups:read",
        "chat:write"
      ],
      "user": [
        "channels:read",
        "groups:read",
        "groups:write.invites"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
